DATABASE_URL=postgres://postgres:admin@127.0.0.1:5432/wellfind-db
PAYLOAD_SECRET=YOUR_SECRET_HERE

# SMTP configuration for password-reset OTP emails
# Configure these with your SMTP provider before using the forgot-password flow.
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@wellfind.academy
SMTP_FROM_NAME=Wellfind Academic

# First admin account seeder (run once via scripts/seed-admin.ts)
# Remove INITIAL_ADMIN_PASSWORD from deployment environments after initial setup.
INITIAL_ADMIN_EMAIL=427rohit@gmail.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_MIN_8_CHARS

# OTP configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
