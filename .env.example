DATABASE_URL=postgres://postgres:admin@127.0.0.1:5432/wellfind-db
PAYLOAD_SECRET=YOUR_SECRET_HERE

# SMTP configuration for password-reset OTP emails
# Configure these with your SMTP provider before using the forgot-password flow.
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@wellfind.academy
SMTP_FROM_NAME=Wellfind Academic

# Teacher dashboard login page link included in the credentials email (optional)
TEACHER_LOGIN_URL=http://localhost:5173/login

# First admin account seeder (run once via scripts/seed-admin.ts)
# Remove INITIAL_ADMIN_PASSWORD from deployment environments after initial setup.
INITIAL_ADMIN_EMAIL=427rohit@gmail.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_MIN_8_CHARS

# OTP configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Teacher registration fee payment details shown in the teacher portal (optional)
REGISTRATION_FEE_UPI_ID=
REGISTRATION_FEE_PAYEE_NAME=Wellfind Academic

# --- Mail system (all optional; sensible defaults are built in) ---
# SMTP_SECURE=true            # force implicit TLS (defaults to true only for port 465)
# MAIL_REPLY_TO=
# MAIL_BRAND_NAME=Wellfind Academic
# MAIL_SUPPORT_EMAIL=info@example.com
# MAIL_DRY_RUN=false          # true: record emails in the Mail tab but never send them
# APP_PORTAL_URL=http://localhost:5173
# TEACHER_PORTAL_URL=         # defaults to APP_PORTAL_URL/teacher
# ADMIN_PORTAL_URL=           # defaults to APP_PORTAL_URL/admin
# REGISTRATION_FEE_AMOUNT=1000
# REGISTRATION_VALIDITY_DAYS=365
# REGISTRATION_EXPIRY_REMINDER_DAYS=30,7
# CRON_SECRET=                # lets a scheduler call POST /api/admin/mail/jobs with header x-cron-secret

# --- Razorpay (online payments) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Google Analytics 4 (CRM analytics, server-side only) ---
# Numeric Property ID (GA > Admin > Property details), NOT the G-XXXX measurement id.
GA4_PROPERTY_ID=
# Service account email; add it as a Viewer in GA > Admin > Property access management.
GA4_CLIENT_EMAIL=
# Service account private key, in quotes, with \n line breaks.
GA4_PRIVATE_KEY=

# --- Cloudinary (file & image uploads) ---
# Cloudinary Dashboard > Settings > API Keys. When these are empty, files stay on local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional root folder inside your Cloudinary media library (default: wellfind)
# CLOUDINARY_FOLDER=wellfind

# --- Web Push (self-hosted browser notifications) ---
# Generate once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
