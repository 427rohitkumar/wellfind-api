# Isolated TEST environment. Used ONLY by vitest (see vitest.config.mts).
# Local docker container `wellfind-test-postgres` (postgres:17) on 127.0.0.1:15432.
# Never put real/remote credentials in this file; the test guard rejects non-local databases.
DATABASE_URL=postgresql://wellfind_test:<local-test-password>@127.0.0.1:15432/wellfind_test
PAYLOAD_SECRET=test-only-payload-secret-not-for-production
NOTIFICATION_ENV=development
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
REGISTRATION_FEE_UPI_ID=test@upi
REGISTRATION_FEE_PAYEE_NAME="Test Payee"
RAZORPAY_WEBHOOK_SECRET=test-webhook-secret
